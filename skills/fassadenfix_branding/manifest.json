{
  "manifest_version": "1.0",
  "type": "skill",
  "name": "fassadenfix_branding",
  "version": "1.0.0",
  "description": "Wendet FassadenFix Corporate Design und Branding-Richtlinien automatisch an. STANDARD-SKILL mit höchster Priorität - bei allen Anwendungen, Modulen, Agents und Plattformen standardmäßig aktiviert (Opt-Out-Prinzip/Widerspruchslösung).",
  "author": "FassadenFix",
  "tags": [
    "branding",
    "corporate-design",
    "styling",
    "css",
    "ui",
    "ux",
    "colors",
    "typography",
    "fassadenfix",
    "default",
    "global"
  ],
  "capabilities": [
    "branding",
    "styling",
    "visual_design",
    "css_generation",
    "ui_theming"
  ],
  "implementation": {
    "language": "python",
    "entrypoint": "main.py"
  },
  "interface": {
    "inputs": [
      {
        "name": "apply_branding",
        "type": "boolean",
        "description": "Branding anwenden (Standard: true). Auf false setzen für Opt-Out.",
        "required": false,
        "default": true
      },
      {
        "name": "output_format",
        "type": "string",
        "description": "Ausgabeformat für Branding-Ressourcen",
        "required": false,
        "default": "css",
        "enum": ["css", "tailwind", "json", "scss"]
      },
      {
        "name": "components",
        "type": "array",
        "description": "Spezifische Komponenten zum Stylen (leer = alle)",
        "required": false,
        "default": []
      }
    ],
    "outputs": [
      {
        "name": "styles",
        "type": "string",
        "description": "Generierte Styles im gewählten Format"
      },
      {
        "name": "colors",
        "type": "object",
        "description": "FassadenFix Farbpalette"
      },
      {
        "name": "typography",
        "type": "object",
        "description": "Typografie-Einstellungen"
      },
      {
        "name": "branding_applied",
        "type": "boolean",
        "description": "Ob Branding angewendet wurde"
      }
    ]
  },
  "dependencies": [],
  "orchestration": {
    "default_enabled": true,
    "priority": 100,
    "scope": "global",
    "auto_inject": true,
    "opt_out_keywords": [
      "--no-branding",
      "--skip-fassadenfix-style",
      "branding: false",
      "ohne FassadenFix Branding",
      "abweichendes Design",
      "custom branding",
      "eigenes Design"
    ]
  },
  "metadata": {
    "created_at": "2026-01-30T11:15:00Z",
    "updated_at": "2026-01-30T11:15:00Z",
    "license": "Proprietary - FassadenFix GmbH",
    "documentation": "SKILL.md"
  }
}
